# Demo mode works with all of these unset.

# TypeSafe / Jev (server-side only). Without this key, a typed mock client is used.
TYPESAFE_API_KEY=

# Cover-letter drafts. Template fallback if unset.
OPENAI_API_KEY=
# Optional: Netlify AI Gateway or other OpenAI-compatible base URL.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Postgres (Netlify Database). Local default is SQLite at .data/apply-os.db
NETLIFY_DATABASE_URL=

# Real Playwright URL import / discovery. Leave false. Demo mode never launches a browser.
APPLY_OS_BROWSER_ASSIST=false
