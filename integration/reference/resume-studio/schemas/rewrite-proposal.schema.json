{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apply-os:resume-studio:rewrite-proposal:1.0.0",
  "title": "rewrite-proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "originalClaimId",
    "text",
    "evidenceIds"
  ],
  "properties": {
    "originalClaimId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
