{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apply-os:resume-studio:resume-plan:1.0.0",
  "title": "resume-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "contextHash",
    "policyHash",
    "scope",
    "entryIds",
    "allowedClaimIds",
    "coverage",
    "warnings"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "candidateId",
        "jobId",
        "profileVersion",
        "profileHash",
        "decisionPolicyVersion",
        "decisionPolicyHash",
        "jobHash"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decisionPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decisionPolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jobHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "allowedClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "claimIds",
          "support"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "support": {
            "enum": [
              "SUPPORTED",
              "PARTIAL",
              "UNSUPPORTED",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
